# 把这个文件复制成 .env，填上你自己的，然后双击 start.command。
#
# ★ .env 已经写进 .gitignore —— 它不会进仓库。
# ★ key 也不会进数据库、不会进 /api/export 导出的备份。
#   这一薄层后端存在的唯一理由，就是替你拿着它、不让它进浏览器。

# ── 接哪个模型 ──────────────────────────────────────────
# 任何「OpenAI 兼容」的服务都行，改这三行就换家：
#
#   DeepSeek     https://api.deepseek.com          deepseek-chat
#   Kimi         https://api.moonshot.cn           moonshot-v1-8k
#   智谱         https://open.bigmodel.cn/api/paas  glm-4-flash
#   硅基流动     https://api.siliconflow.cn        Qwen/Qwen2.5-7B-Instruct
#   OpenRouter   https://openrouter.ai/api         (很多家)
#   OpenAI       https://api.openai.com            gpt-4o-mini
#   Ollama(本机) http://127.0.0.1:11434            llama3.2   ← 本机模型不用 key
#
LIANHUAN_API_KEY=
LIANHUAN_API_BASE=https://api.deepseek.com
LIANHUAN_API_MODEL=deepseek-chat

# 开到网络上时必须自己填至少 16 个字符；纯本机启动不会用它。
LIANHUAN_PASSWORD=
# HTTPS / 反代设 1；仅可信局域网明文 HTTP 才显式设 0。留空时按请求协议判断。
# LIANHUAN_COOKIE_SECURE=1

# ── 数据存哪儿 ──────────────────────────────────────────
# 默认就在 data/lianhuan.db。想换个地方就改这行。搬家就是拷这个文件。
# LIANHUAN_DB=data/lianhuan.db
